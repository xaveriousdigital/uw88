<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/ivWallpaper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/bg_dark"
            android:clickable="true"
            android:contentDescription="@string/cd_wallpaper_preview"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/placeholder_wallpaper" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivWallpaper"
            tools:text="Puncak Kabut Biru" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingTop="2dp"
            android:text="@string/wallpaper_resolution_tag"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnduh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:text="@string/btn_unduh"
                android:textAllCaps="false"
                android:textColor="@color/accent_gold_light"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/bg_dark"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="15dp"
                app:iconTint="@color/accent_gold_light"
                app:strokeColor="@color/accent_gold_light"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:text="@string/btn_pasang"
                android:textAllCaps="false"
                android:textColor="@color/on_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_gold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_wallpaper"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="15dp"
                app:iconTint="@color/on_gold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
